{
  "expo": {
    "name": "Andora",
    "slug": "andora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/andora-logo-icon1.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bitcode": false,
      "bundleIdentifier": "io.livekit.voiceassistantreactnative"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/andora-logo-icon1.png",
        "backgroundColor": "#0B0B10"
      },
      "package": "io.livekit.voiceassistantreactnative",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "splash": {
        "image": "./assets/images/andora-logo-icon1.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B0B10"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/andora-logo-icon1.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B10"
        }
      ],
      "expo-font",
      "./plugins/withReactNativeShare",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/andora-logo-icon1.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B10"
    }
  }
}
